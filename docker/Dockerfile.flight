# ---------------------------------------------------------------------------
# BenoStreamDB Flight SQL Service
# Arrow Flight SQL gateway (Port 50051) — ADBC, JDBC, ODBC, BI tools
# ---------------------------------------------------------------------------
FROM rust:1.100-slim AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    python3 \
    libpython3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace manifests for dependency caching
COPY Cargo.toml Cargo.lock ./
COPY benodb-gpu-ann/Cargo.toml benodb-gpu-ann/Cargo.toml
COPY server/flight_sql/Cargo.toml server/flight_sql/Cargo.toml
COPY contrib/benodb-search/Cargo.toml contrib/benodb-search/Cargo.toml
COPY contrib/benodb-mcp/Cargo.toml contrib/benodb-mcp/Cargo.toml

# Create stub sources for dependency layer caching and manifest validation
RUN mkdir -p src \
    && echo "pub fn stub() {}" > src/lib.rs \
    && echo "fn main() {}" > build.rs \
    && mkdir -p benodb-gpu-ann/src \
    && echo "pub fn stub() {}" > benodb-gpu-ann/src/lib.rs \
    && mkdir -p server/flight_sql/src \
    && echo "fn main() {}" > server/flight_sql/src/main.rs \
    && mkdir -p contrib/benodb-search/src \
    && echo "fn main() {}" > contrib/benodb-search/src/main.rs \
    && echo "pub fn stub() {}" > contrib/benodb-search/src/lib.rs \
    && mkdir -p contrib/benodb-mcp/src \
    && echo "pub fn stub() {}" > contrib/benodb-mcp/src/lib.rs \
    && echo "fn main() {}" > contrib/benodb-mcp/src/main.rs \
    && mkdir -p tests/bin benches \
    && echo "fn main() {}" > tests/test_connector_ffi.rs \
    && echo "fn main() {}" > tests/bin/generate_iceberg_manifests.rs \
    && echo "fn main() {}" > tests/bin/verify_iceberg_read_check.rs \
    && echo "fn main() {}" > benches/performance.rs \
    && echo "fn main() {}" > benches/bench_table.rs \
    && cargo build --locked --release -p benodb-flight \
    && rm -rf target/release/.fingerprint/benodb* \
              target/release/deps/*benodb* \
              target/release/deps/libbenodb* \
              target/release/build/benodb* \
              target/release/benodb-flight*

# Copy actual source
COPY build.rs ./
COPY src ./src
COPY benodb-gpu-ann/src ./benodb-gpu-ann/src
COPY server/flight_sql/src ./server/flight_sql/src

# Build the flight SQL binary
RUN cargo build --locked --release -p benodb-flight


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y \
    libssl3t64 \
    ca-certificates \
    curl \
    python3 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r benodb && useradd -r -m -g benodb benodb
RUN mkdir -p /home/benodb/.benodb && chown -R benodb:benodb /home/benodb

WORKDIR /app

COPY --from=builder /app/target/release/benodb-flight /usr/local/bin/

# Arrow Flight SQL gRPC
EXPOSE 50051

# gRPC health check via curl to gRPC reflection (fallback: TCP check)
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -sf http://localhost:9090/health || exit 1

USER benodb

ENV RUST_LOG=info

ENTRYPOINT ["benodb-flight"]
CMD []
